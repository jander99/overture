{
  "name": "@overture/scan-matrix",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/scan-matrix/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/scan-matrix",
        "main": "packages/scan-matrix/src/index.ts",
        "tsConfig": "packages/scan-matrix/tsconfig.lib.json",
        "platform": "node",
        "format": ["esm"],
        "bundle": true,
        "thirdParty": true,
        "generatePackageJson": false
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{projectRoot}/test-output/vitest/coverage"
      ],
      "options": {
        "coverage.reportsDirectory": "../../coverage/packages/scan-matrix"
      }
    }
  }
}
